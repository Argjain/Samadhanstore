<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <title><%= pageTitle %></title>
  <meta property="og:title" content="<%= post.title %>">
  <meta property="og:description" content="<%= post.excerpt || '' %>">
  <% if(post.image) { %><meta property="og:image" content="<%= post.image %>"><% } %>
</head>
<body data-loggedin="<%= currentUser?'true':'false' %>">
  <div class="particles" id="particles"></div>
  <%- include('../partials/navbar') %>

  <div class="page-wrap" style="max-width:820px;">
    <div class="breadcrumb"><a href="/">Home</a><span>›</span><a href="/blog">Blog</a><span>›</span><span><%= post.title %></span></div>

    <article class="blog-article reveal">
      <% if(post.tags) { %>
        <div class="blog-tags" style="margin-bottom:16px;">
          <% post.tags.split(',').forEach(tag => { %>
            <span class="blog-tag"><%= tag.trim() %></span>
          <% }) %>
        </div>
      <% } %>

      <h1 class="blog-article-title"><%= post.title %></h1>

      <div class="blog-article-meta">
        <span>📅 <%= new Date(post.created_at).toLocaleDateString('en-IN', {day:'numeric',month:'long',year:'numeric'}) %></span>
        <span>✍️ <%= post.author || 'Samadhan' %></span>
      </div>

      <% if(post.image) { %>
        <div class="blog-article-hero">
          <img src="<%= imageUrl(post.image,480) %>" alt="<%= post.title %>">
        </div>
      <% } %>

      <div class="blog-content">
        <%- post.content %>
      </div>
    </article>

    <!-- Share buttons -->
    <div class="blog-share">
      <span style="font-size:.82rem;color:var(--text-muted);margin-right:12px;">Share:</span>
      <a href="https://wa.me/?text=<%= encodeURIComponent(post.title + ' - ' + config.site.url + '/blog/' + post.slug) %>" target="_blank" class="share-btn">WhatsApp</a>
      <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(config.site.url + '/blog/' + post.slug) %>" target="_blank" class="share-btn">Facebook</a>
      <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(post.title) %>&url=<%= encodeURIComponent(config.site.url + '/blog/' + post.slug) %>" target="_blank" class="share-btn">Twitter</a>
    </div>

    <!-- Recent posts -->
    <% if(recentPosts && recentPosts.length) { %>
      <div style="margin-top:60px;">
        <h3 style="font-family:'Cinzel',serif;color:var(--indigo);margin-bottom:20px;text-align:center;">More Articles</h3>
        <div class="blog-grid" style="grid-template-columns:repeat(auto-fill,minmax(250px,1fr));">
          <% recentPosts.forEach(p => { %>
            <a href="/blog/<%= p.slug %>" class="blog-card">
              <div class="blog-card-img">
                <% if(p.image) { %><img src="<%= p.image %>" alt="<%= p.title %>" loading="lazy"><% } else { %><div class="blog-card-placeholder">📿</div><% } %>
              </div>
              <div class="blog-card-body">
                <h2 class="blog-card-title" style="font-size:1rem;"><%= p.title %></h2>
                <div class="blog-card-meta"><span><%= new Date(p.created_at).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %></span></div>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
