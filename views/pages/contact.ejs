<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8">
<!-- Favicon -->
<link rel="icon" type="image/png" sizes="32x32" href="/images/logo/favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/images/logo/favicon-16.png">
<link rel="shortcut icon" href="/images/logo/favicon.png">
<link rel="apple-touch-icon" sizes="180x180" href="/images/logo/apple-touch-icon.png"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= pageTitle %></title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css?v=a4c169302152"></head>
<body data-loggedin="<%= currentUser?'true':'false' %>"><div class="particles" id="particles"></div><%- include('../partials/navbar') %>
<div class="page-wrap">
  <div class="section-title reveal"><h2>Get in Touch</h2><p>We are here for you — let us know if you have any questions!</p></div>
  <%if(success&&success.length){%><div class="alert alert-success" style="max-width:600px;margin:0 auto 28px;">✓ <%=success[0]%></div><%}%>
  <div class="contact-grid">
    <div class="reveal">
      <h3 style="font-family:'Cinzel',serif;font-size:1.5rem;color:var(--silver);margin-bottom:14px;">Samadhan</h3>
      <p style="color:var(--text-muted);line-height:1.7;margin-bottom:28px;">Any questions? We will reply within 24 hours.</p>
      <div class="contact-item"><div class="contact-item-icon">📧</div><div><strong style="font-family:'Cinzel',serif;font-size:.8rem;color:var(--text);display:block;margin-bottom:3px;">EMAIL</strong><a href="mailto:<%= S&&S.site_email||'support@samadhanstore.com' %>" style="color:var(--lavender-light);"><%= S&&S.site_email||'support@samadhanstore.com' %></a></div></div>
      <div class="contact-item"><div class="contact-item-icon">📞</div><div><strong style="font-family:'Cinzel',serif;font-size:.8rem;color:var(--text);display:block;margin-bottom:3px;">PHONE / WHATSAPP</strong><a href="https://wa.me/<%= S&&S.site_whatsapp||'918630437326' %>" style="color:var(--lavender-light);"><%= S&&S.site_phone||'+91 98765 43210' %></a></div></div>
      <div class="contact-item"><div class="contact-item-icon">🕐</div><div><strong style="font-family:'Cinzel',serif;font-size:.8rem;color:var(--text);display:block;margin-bottom:3px;">HOURS</strong><span style="color:var(--text-muted);">Mon–Sat: 10am – 7pm</span></div></div>
      <div class="contact-item"><div class="contact-item-icon">🏠</div><div><strong style="font-family:'Cinzel',serif;font-size:.8rem;color:var(--text);display:block;margin-bottom:3px;">ADDRESS</strong><span style="color:var(--text-muted);"><%= S&&S.site_address||'Delhi, India' %></span></div></div>
    </div>
    <div class="form-section reveal">
      <h3>Send a Message</h3>
      <%if(error&&error.length){%><div class="alert alert-error">⚠ <%=error[0]%></div><%}%>
      <form method="POST" action="/contact">
        <div class="form-row">
          <div class="form-group"><label>Name *</label><input type="text" name="name" placeholder="Your name" required></div>
          <div class="form-group"><label>Email *</label><input type="email" name="email" placeholder="aap@email.com" required></div>
        </div>
        <div class="form-group"><label>Phone</label><input type="tel" name="phone" placeholder="+91 XXXXX XXXXX"></div>
        <div class="form-group"><label>Subject</label><select name="subject"><option>Order Query</option><option>Product Info</option><option>Return/Refund</option><option>Spiritual Guidance</option><option>Other</option></select></div>
        <div class="form-group"><label>Message *</label><textarea name="message" rows="5" placeholder="Write your message here..." required></textarea></div>
        <button type="submit" class="btn-primary" style="width:100%;">Send Message 🙏</button>
      </form>
    </div>
  </div>
</div>
<%- include('../partials/footer') %></body></html>
