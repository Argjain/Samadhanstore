<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8">
<!-- Favicon -->
<link rel="icon" type="image/png" sizes="32x32" href="/images/logo/favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/images/logo/favicon-16.png">
<link rel="shortcut icon" href="/images/logo/favicon.png">
<link rel="apple-touch-icon" sizes="180x180" href="/images/logo/apple-touch-icon.png"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= pageTitle %></title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Cormorant+Garamond:wght@300;400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css?v=a4c169302152"></head>
<body class="admin-body"><%- include('../../partials/admin-nav') %>
<div class="admin-wrap" style="max-width:900px;">
  <%if(success&&success.length){%><div class="alert alert-success">✓ <%=success[0]%></div><%}%>
  <%if(error&&error.length){%><div class="alert alert-error" role="alert"><%=error[0]%></div><%}%>
  <h2 style="font-family:'Cinzel',serif;color:var(--lavender-light);margin-bottom:6px;">Site Settings</h2>
  <p style="color:var(--text-muted);margin-bottom:28px;font-size:.9rem;">Update everything from the admin panel — no code changes required.</p>

  <form method="POST" action="/admin/settings">
    <% const groupLabels={general:'🌐 General Info',social:'📱 Social Media',shipping:'🚚 Shipping',payment:'💳 Payment',marketing:'🎯 Marketing',seo:'🔍 SEO',}; %>
    <% Object.entries(grouped).forEach(([group, settings]) => { %>
    <div class="form-section" style="margin-bottom:20px;">
      <h3><%= groupLabels[group]||group.charAt(0).toUpperCase()+group.slice(1) %></h3>
      <% settings.forEach(s=>{ %>
      <div class="form-group">
        <label><%= s.label %></label>
        <% if(s.type==='textarea'){ %>
          <textarea name="<%= s.key_name %>" rows="3"><%= s.value||'' %></textarea>
        <% } else if(s.type==='boolean'){ %>
          <div style="display:flex;align-items:center;gap:10px;">
            <input type="checkbox" name="<%= s.key_name %>" value="1" <%= s.value==='1'?'checked':'' %> style="width:18px;height:18px;accent-color:var(--lavender);">
            <span style="color:var(--text-muted);font-size:.88rem;">Enable/Disable</span>
          </div>
        <% } else if(s.type==='color'){ %>
          <input type="color" name="<%= s.key_name %>" value="<%= s.value||'#2d1b69' %>" style="height:40px;width:80px;">
        <% } else if(s.type==='number'){ %>
          <input type="number" name="<%= s.key_name %>" value="<%= s.value||0 %>" step="0.01" style="max-width:180px;">
        <% } else { %>
          <input type="text" name="<%= s.key_name %>" value="<%= s.value||'' %>">
        <% } %>
      </div>
      <% }) %>
    </div>
    <% }) %>
    <div style="position:sticky;bottom:20px;background:var(--bg);padding:16px 0;border-top:1px solid var(--border);">
      <button type="submit" class="btn-primary" style="width:100%;max-width:300px;">Save All Settings ✅</button>
    </div>
  </form>
</div>
<script src="/js/main.js?v=2e61b06716d2"></script></body></html>
