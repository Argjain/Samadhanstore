<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8">
<link rel="icon" type="image/png" sizes="32x32" href="/images/logo/favicon-32.png">
<link rel="shortcut icon" href="/images/logo/favicon.png">
<meta name="viewport" content="width=device-width,initial-scale=1"><title><%= pageTitle %></title>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css?v=a4c169302152"></head>
<body class="admin-body"><%- include('../../partials/admin-nav') %>
<div class="admin-wrap" style="max-width:800px;">
  <%if(success&&success.length){%><div class="alert alert-success">✓ <%=success[0]%></div><%}%>
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
    <h2 style="font-family:'Roboto',sans-serif;font-weight:700;color:var(--lavender-light);">Edit Post</h2>
    <a href="/admin/blogs" class="btn-outline btn-sm">← Back</a>
  </div>

  <div class="form-section">
    <form method="POST" action="/admin/blogs/<%= post.id %>?_method=PUT" enctype="multipart/form-data">
      <div class="form-group"><label>Title *</label><input type="text" name="title" required value="<%= post.title %>"></div>
      <div class="form-group">
        <label>Featured Image <%= post.image ? '(current set — upload new to replace)' : '' %></label>
        <% if(post.image) { %><img src="<%= post.image %>" style="width:100%;max-height:200px;object-fit:cover;border-radius:8px;margin-bottom:8px;"><% } %>
        <input type="file" name="image" accept="image/*">
      </div>
      <div class="form-group"><label>Tags</label><input type="text" name="tags" value="<%= post.tags || '' %>" placeholder="crystals, zodiac"></div>
      <div class="form-group"><label>Author</label><input type="text" name="author" value="<%= post.author || 'Samadhan' %>"></div>
      <div class="form-group">
        <label>Content *</label>
        <textarea name="content" rows="15" required style="font-family:monospace;font-size:.85rem;"><%= post.content %></textarea>
      </div>
      <div class="form-group"><label>Excerpt</label><textarea name="excerpt" rows="2"><%= post.excerpt || '' %></textarea></div>
      <div class="form-group" style="display:flex;align-items:center;gap:10px;">
        <input type="checkbox" name="is_published" id="blog_pub" <%= post.is_published ? 'checked' : '' %>>
        <label for="blog_pub" style="margin:0;cursor:pointer;">Published</label>
      </div>
      <button type="submit" class="btn-primary" style="width:100%;">Save Changes</button>
    </form>
  </div>
</div>
<script src="/js/main.js?v=2e61b06716d2"></script></body></html>
