<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8">
<!-- Favicon -->
<link rel="icon" type="image/png" sizes="32x32" href="/images/logo/favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/images/logo/favicon-16.png">
<link rel="shortcut icon" href="/images/logo/favicon.png">
<link rel="apple-touch-icon" sizes="180x180" href="/images/logo/apple-touch-icon.png"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= pageTitle %></title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Cormorant+Garamond:wght@300;400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css?v=a4c169302152"></head>
<body class="admin-body"><%- include('../../partials/admin-nav') %>
<div class="admin-wrap">
  <%if(success&&success.length){%><div class="alert alert-success">✓ <%=success[0]%></div><%}%>
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px;">
    <h2 style="font-family:'Cinzel',serif;color:var(--lavender-light);">All Orders (<%= orders.length %>)</h2>
    <form action="/admin/orders" method="GET" style="display:flex;gap:8px;flex-wrap:wrap;">
      <input type="text" name="search" placeholder="Order ID / Name / Phone" value="<%= search %>" style="background:rgba(255,255,255,.05);border:1px solid var(--border);color:var(--text);padding:8px 12px;border-radius:6px;font-size:.88rem;outline:none;">
      <select name="status" style="background:rgba(255,255,255,.05);border:1px solid var(--border);color:var(--text);padding:8px 12px;border-radius:6px;font-size:.88rem;outline:none;">
        <option value="">All Status</option>
        <% ['placed','confirmed','processing','shipped','out_for_delivery','delivered','cancelled'].forEach(s=>{%><option value="<%= s %>" <%=filterStatus===s?'selected':''%>><%= s.replace(/_/g,' ') %></option><%})%>
      </select>
      <button type="submit" class="btn-primary btn-sm">Search</button>
    </form>
  </div>
  <div style="display:flex;gap:8px;margin-bottom:18px;flex-wrap:wrap;">
    <% ['','placed','confirmed','processing','shipped','out_for_delivery','delivered','cancelled'].forEach(s=>{%>
    <a href="/admin/orders<%=s?'?status='+s:''%>" class="btn-sm <%=filterStatus===s?'btn-primary':'btn-outline'%>" style="text-transform:capitalize;"><%= s||'All' %></a>
    <%})%>
  </div>
  <div style="overflow-x:auto;">
  <table class="admin-table">
    <thead><tr><th>Order ID</th><th>Customer</th><th>Address</th><th>Items</th><th>Total</th><th>Payment</th><th>Status</th><th>Date</th><th>Update</th></tr></thead>
    <tbody>
      <% orders.forEach(o=>{const sc={placed:'#e8b84b',confirmed:'#4a90e2',processing:'#8b7fd4',shipped:'#9b59b6',out_for_delivery:'#e8a84b',delivered:'#4caf7d',cancelled:'#e05252'}[o.order_status]||'#9a8460';%>
      <tr>
        <td style="font-family:'Cinzel',serif;font-size:.78rem;color:var(--lavender-light);"><%= o.order_id %><br><a href="<%=o.customerTrackingUrl%>">Customer tracking link</a></td>
        <td><div style="font-weight:600;font-size:.9rem;"><%= o.name %></div><div style="color:var(--text-muted);font-size:.76rem;"><%= o.email %></div><div style="color:var(--lavender-light);font-size:.82rem;"><%= o.phone %></div></td>
        <td style="color:var(--text-muted);font-size:.8rem;max-width:150px;"><%= o.address %>,<br><%= o.city %>, <%= o.state %> - <%= o.pincode %></td>
        <td style="font-size:.82rem;"><% o.items.forEach(i=>{%><div><%= i.name %> ×<%= i.qty %></div><%})%></td>
        <td style="font-family:'Cinzel',serif;color:var(--lavender-light);white-space:nowrap;"><%= business.currencySymbol %><%= Number(o.total).toLocaleString('en-IN') %><br><span style="font-size:.72rem;color:var(--text-muted);">COD: <%=business.currencySymbol%><%=Number(o.total).toLocaleString('en-IN')%></span></td>
        <td><%- o.payment_status==='paid'?'<span style="color:#4caf7d">✅ Paid</span>':'<span style="color:var(--warning)">💵 COD</span>' %></td>
        <td><span class="badge-status" style="background:<%= sc %>22;color:<%= sc %>;border:1px solid <%= sc %>44;"><%= o.order_status.replace(/_/g,' ') %></span></td>
        <td style="color:var(--text-muted);font-size:.78rem;white-space:nowrap;"><%= new Date(o.created_at).toLocaleDateString('en-IN') %></td>
        <td>
          <form method="POST" action="/admin/orders/<%= o.order_id %>/status">
            <select name="status" style="width:100%;padding:4px;font-size:.76rem;background:rgba(255,255,255,.05);border:1px solid var(--border);color:var(--text);border-radius:4px;margin-bottom:4px;">
              <% ['placed','confirmed','processing','shipped','out_for_delivery','delivered','cancelled'].forEach(s=>{%><option value="<%= s %>" <%=o.order_status===s?'selected':''%>><%= s.replace(/_/g,' ') %></option><%})%>
            </select>
            <input type="text" name="tracking_id" placeholder="Tracking ID" value="<%= o.tracking_id||'' %>" style="width:100%;padding:4px 8px;font-size:.76rem;background:rgba(255,255,255,.05);border:1px solid var(--border);color:var(--text);border-radius:4px;margin-bottom:4px;outline:none;">
            <button type="submit" class="btn-primary btn-sm" style="width:100%;">Update</button>
          </form>
        </td>
      </tr>
      <%})%>
    </tbody>
  </table>
  </div>
</div>
<script src="/js/main.js?v=2e61b06716d2"></script></body></html>
